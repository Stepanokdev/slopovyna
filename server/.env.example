# docker compose settings (copy to .env next to docker-compose.yml)
SLOP_HOST=slop.example.com
SLOP_ENV_FILE=/opt/slopovyna-secrets/slopovyna.env
SLOP_DATA=/opt/slopovyna-data

# The server's own settings go in the SLOP_ENV_FILE above (chmod 600), not here:
# BASE_URL=https://slop.example.com
# GITHUB_CLIENT_ID=...
# GITHUB_CLIENT_SECRET=...
# SLOP_SECRET=<64 random hex characters: openssl rand -hex 32>
